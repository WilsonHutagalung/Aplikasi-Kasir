{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "name": "aplikasi-kasir",
    "version": "1.0.0",
    "description": "Aplikasi Kasir Digital berbasis Laravel & React",
    "author": "Kasir App",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "electron": "electron .",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
        "electron:build": "npm run build && electron-builder --win --x64",
        "electron:build:portable": "npm run build && electron-builder --win portable"
    },
    "dependencies": {
        "axios": "^1.11.0",
        "lucide-react": "^0.475.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.5"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.0.1",
        "electron": "^33.4.11",
        "electron-builder": "^25.1.8",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "wait-on": "^8.0.5"
    },
    "build": {
        "appId": "com.kasir.aplikasi",
        "productName": "Aplikasi Kasir",
        "copyright": "Copyright © 2026",
        "directories": {
            "output": "dist-desktop"
        },
        "forceCodeSigning": false,
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "electron/icon.png",
            "sign": null,
            "requestedExecutionLevel": "requireAdministrator"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Aplikasi Kasir",
            "license": null,
            "installerLanguages": [
                "id"
            ],
            "language": "1057"
        },
        "asar": false,
        "files": [
            "electron/**/*"
        ],
        "extraResources": [
            {
                "from": ".",
                "to": "laravel",
                "filter": [
                    "app/**/*",
                    "bootstrap/**/*",
                    "config/**/*",
                    "database/**/*",
                    "public/**/*",
                    "resources/views/**/*",
                    "routes/**/*",
                    "storage/**/*",
                    "vendor/**/*",
                    "artisan",
                    "server.php",
                    ".env"
                ]
            }
        ]
    }
}
